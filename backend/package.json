{
  "name": "movie-rental-management-backend",
  "version": "1.0.0",
  "description": "Backend for movie rental management system",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "migrate": "node -r ts-node/register node_modules/.bin/typeorm migration:run",
    "migrate:revert": "node -r ts-node/register node_modules/.bin/typeorm migration:revert",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "typescript": "^5.0.0",
    "mysql2": "^3.2.0",
    "sequelize": "^6.31.0",
    "redis": "^4.6.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "joi": "^17.9.1",
    "axios": "^1.3.4",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^6.7.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^18.15.10",
    "@types/jest": "^29.5.0",
    "nodemon": "^2.0.20",
    "ts-node": "^10.9.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "eslint": "^8.37.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0"
  }
}
